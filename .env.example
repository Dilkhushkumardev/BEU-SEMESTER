# ==============================================================================
# Semester Point — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env.local` for local development.
# DO NOT commit sensitive production keys to version control.

# Application Base URL
VITE_APP_URL=http://localhost:5173

# Optional: Analytics / Monitoring
VITE_ENABLE_ANALYTICS=false
VITE_ANALYTICS_ID=

# Optional: AI Service Integration (Client-safe proxies or API endpoints)
# Note: Keep secret keys on server-side or secure proxy functions.
VITE_AI_API_ENDPOINT=
